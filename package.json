{
  "name": "syntagmax-vscode",
  "displayName": "Syntagmax",
  "publisher": "scartill",
  "description": "VS Code extension for Syntagmax DSL",
  "icon": "images/syntagmax_64x64.png",
  "repository": "https://github.com/scartill/syntagmax-vscode",
  "version": "0.0.9",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "syntagmax",
        "aliases": [
          "Syntagmax",
          "syntagmax"
        ],
        "extensions": [
          ".stmx",
          ".syntagmax"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "syntagmax",
        "scopeName": "source.syntagmax",
        "path": "./syntagmax.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "vscode-languageclient": "^9.x"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.x"
  }
}
